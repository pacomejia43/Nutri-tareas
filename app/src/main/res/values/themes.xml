<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme: Compose (Material3) owns all real theming in ui/theme/Theme.kt.
         This only avoids a flash of the wrong background before Compose draws. -->
    <style name="Theme.NutriTareas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
